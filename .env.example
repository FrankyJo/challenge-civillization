# Copy to `.env` for local development. Every value here is a non-secret local
# default for the Docker Compose infrastructure; real secrets are injected by
# the deployment environment and never committed.
NODE_ENV=development
LOG_LEVEL=info

# Infrastructure (docker compose: `pnpm infra:up`)
DATABASE_URL=postgresql://civilization:civilization@127.0.0.1:5432/civilization
REDIS_URL=redis://127.0.0.1:6379

# Integration tests / smoke test: admin URL used to create throwaway databases
TEST_DATABASE_URL=postgresql://civilization:civilization@127.0.0.1:5432/civilization
TEST_REDIS_URL=redis://127.0.0.1:6379

# Process ports (health endpoints: /health and /health/ready)
API_HOST=127.0.0.1
API_PORT=3000
SIMULATION_HEALTH_HOST=127.0.0.1
SIMULATION_HEALTH_PORT=3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
WORKER_CONCURRENCY=4
# Outbox relay cadence and the Redis-loss safety net (projection reconcile)
OUTBOX_RELAY_INTERVAL_MS=500
PROJECTION_RECONCILE_INTERVAL_MS=30000

# Web (Vite dev/preview proxy `/api` -> API_BASE_URL)
WEB_PORT=5173
WEB_PREVIEW_PORT=4173
API_BASE_URL=http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:5173

# Season configuration — consumed from Phase 06 (runner/clock); not read yet.
WORLD_SEED=season-1
SEASON_START_REAL_AT=2030-01-01T00:00:00Z
SEASON_DURATION_DAYS=30
INITIAL_POPULATION=10000
TARGET_END_YEAR=2026

# AI proposals stay disabled until Phase 16. Leave secrets empty here.
AI_PROPOSALS_ENABLED=false
ANTHROPIC_API_KEY=
ADMIN_SESSION_SECRET=
