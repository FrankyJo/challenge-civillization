{
  "name": "civilization-living-history",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic public civilization simulation (monorepo)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "verify:kit": "node scripts/verify-kit.mjs",
    "gates": "node scripts/run-gates.mjs",
    "phase:status": "node scripts/phase-status.mjs",
    "test:starter": "node --test tests/*.test.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "smoke": "node scripts/smoke.mjs",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait postgres redis",
    "db:migrate": "pnpm --filter @civ/db run migrate up",
    "db:rollback": "pnpm --filter @civ/db run migrate down",
    "db:status": "pnpm --filter @civ/db run migrate status",
    "dev": "pnpm --filter @civ/web dev",
    "smoke:container": "bash scripts/container-smoke.sh"
  },
  "devDependencies": {
    "@civ/contracts": "workspace:*",
    "@civ/testing": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2"
  }
}
