{
  "name": "@civ/content",
  "version": "0.1.0",
  "private": true,
  "description": "Signed, versioned historical content packs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "content:build": "node scripts/build-season-one.mjs"
  },
  "dependencies": {
    "@civ/contracts": "workspace:*",
    "zod": "4.6.7",
    "@civ/domain": "workspace:*"
  }
}
