{
  "name": "@civ/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure deterministic simulation domain (no I/O, no wall clock, no ambient randomness)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "bench": "node bench/kernel.bench.mjs"
  },
  "dependencies": {
    "@civ/contracts": "workspace:*"
  },
  "devDependencies": {
    "@civ/testing": "workspace:*"
  }
}
