{
  "name": "@civ/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test infrastructure: contract builders, required test env, ephemeral databases",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@civ/contracts": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
