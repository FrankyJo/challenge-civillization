{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1024
    },
    "height": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1024
    },
    "cellSpacingM": {
      "type": "integer",
      "minimum": 500,
      "maximum": 50000
    },
    "topLatitudeMicroDeg": {
      "type": "integer",
      "minimum": -80000000,
      "maximum": 80000000
    },
    "seaLevelTemperatureTopDeciC": {
      "type": "integer",
      "minimum": -300,
      "maximum": 350
    },
    "seaLevelTemperatureBottomDeciC": {
      "type": "integer",
      "minimum": -300,
      "maximum": 350
    },
    "landFractionPpm": {
      "type": "integer",
      "minimum": 100000,
      "maximum": 900000
    },
    "maxElevationM": {
      "type": "integer",
      "minimum": 100,
      "maximum": 9000
    },
    "maxDepthM": {
      "type": "integer",
      "minimum": 100,
      "maximum": 11000
    },
    "regionTargetCells": {
      "type": "integer",
      "minimum": 4,
      "maximum": 10000
    },
    "minLandmassCells": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "riverMinDischargeM3PerYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "width",
    "height",
    "cellSpacingM",
    "topLatitudeMicroDeg",
    "seaLevelTemperatureTopDeciC",
    "seaLevelTemperatureBottomDeciC",
    "landFractionPpm",
    "maxElevationM",
    "maxDepthM",
    "regionTargetCells",
    "minLandmassCells",
    "riverMinDischargeM3PerYear"
  ],
  "additionalProperties": false,
  "title": "map-params v1",
  "description": "World map generator parameters: grid size and spacing, latitude, temperature, land share, relief, regions."
}
