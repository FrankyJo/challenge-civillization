                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "recorded",
                  "not_recorded"
                ]
              }
            },
            "required": [
              "category",
              "status"
            ],
            "additionalProperties": false
          },
          "cultureId": {
            "type": "string",
            "pattern": "^culture\\.[a-z][a-z0-9_]{1,31}$"
          },
          "householdId": {
            "type": "string",
            "pattern": "^hhd_[0-9a-z]{8,64}$"
          },
          "settlementId": {
            "type": "string",
            "pattern": "^stl_[0-9a-z]{8,64}$"
          },
          "cell": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "motherId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^per_[0-9a-z]{8,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fatherId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^per_[0-9a-z]{8,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "partnerId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^per_[0-9a-z]{8,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maritalStatus": {
            "type": "string",
            "enum": [
              "never_married",
              "married",
              "widowed"
            ]
          },
          "guardian": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "parent",
                      "kin",
                      "foster"
                    ]
                  },
                  "guardianId": {
                    "type": "string",
                    "pattern": "^per_[0-9a-z]{8,64}$"
                  },
                  "relation": {
                    "type": "string",
                    "enum": [
                      "mother",
                      "father",
                      "grandparent",
                      "sibling",
                      "aunt_uncle",
                      "step_parent",
                      "foster_parent"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "guardianId",
                  "relation"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "health": {
            "type": "object",
            "properties": {
              "frailtyPpm": {
                "type": "integer",
                "minimum": 100000,
                "maximum": 5000000
              },
              "disability": {
                "type": "string",
                "enum": [
                  "none",
                  "mobility",
                  "sensory",
                  "cognitive"
                ]
              }
            },
            "required": [
              "frailtyPpm",
              "disability"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "workCapacityPpm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "skills": {
                "type": "object",
                "properties": {
                  "cultivation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "herding": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "fishing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "craft": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "building": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "trade": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "healing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "cultivation",
                  "herding",
                  "fishing",
                  "craft",
                  "building",
                  "trade",
                  "healing"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "workCapacityPpm",
              "skills"
            ],
            "additionalProperties": false
          },
