                              ]
                            }
                          },
                          "required": [
                            "rule",
                            "from",
                            "personId",
                            "base"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "rule": {
                              "type": "string",
                              "const": "place"
                            },
                            "settlementId": {
                              "type": "string",
                              "pattern": "^stl_[0-9a-z]{8,64}$"
                            }
                          },
                          "required": [
                            "rule",
                            "settlementId"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "role",
                    "form",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "display": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "required": [
              "parts",
              "display"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "settlementId",
          "cell",
          "regionId",
          "cultureId",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "households": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "householdId": {
            "type": "string",
            "pattern": "^hhd_[0-9a-z]{8,64}$"
          },
          "settlementId": {
            "type": "string",
            "pattern": "^stl_[0-9a-z]{8,64}$"
          },
          "form": {
            "type": "string",
            "enum": [
              "nuclear",
              "stem",
              "joint",
              "solitary",
              "kin_care"
            ]
          },
          "headId": {
            "type": "string",
            "pattern": "^per_[0-9a-z]{8,64}$"
          },
          "members": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "personId": {
                  "type": "string",
                  "pattern": "^per_[0-9a-z]{8,64}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "head",
                    "spouse",
                    "child",
                    "parent",
                    "sibling",
                    "grandchild",
                    "fosterling"
