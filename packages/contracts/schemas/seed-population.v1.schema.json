            "type": "integer",
            "minimum": -43800,
            "maximum": 9007199254740991
          },
          "sex": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ]
          },
          "gender": {
            "type": "object",
            "properties": {
              "category": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]{1,31}$"
