            "type": "object",
            "properties": {
              "parts": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "given",
                        "patronymic",
                        "matronymic",
                        "clan",
                        "place"
                      ]
                    },
                    "form": {
                      "type": "string",
                      "pattern": "^[a-z]{2,32}$"
                    },
                    "provenance": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "dataset": {
                              "type": "string",
                              "pattern": "^names\\.[a-z][a-z0-9_]{1,31}$"
                            },
                            "version": {
                              "type": "string",
                              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                            },
                            "entryId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40
                            },
                            "fallbackLevel": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4
                            }
                          },
                          "required": [
                            "dataset",
                            "version",
                            "entryId",
                            "fallbackLevel"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "rule": {
                              "type": "string",
                              "enum": [
                                "patronymic",
                                "matronymic",
                                "clan"
                              ]
                            },
                            "from": {
                              "type": "string",
                              "enum": [
                                "father",
                                "mother"
                              ]
                            },
                            "personId": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^per_[0-9a-z]{8,64}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "base": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "dataset": {
                                      "type": "string",
                                      "pattern": "^names\\.[a-z][a-z0-9_]{1,31}$"
                                    },
                                    "version": {
                                      "type": "string",
                                      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                                    },
                                    "entryId": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 40
                                    },
                                    "fallbackLevel": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 4
                                    }
                                  },
                                  "required": [
                                    "dataset",
                                    "version",
                                    "entryId",
                                    "fallbackLevel"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "rule",
                            "from",
                            "personId",
                            "base"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "rule": {
                              "type": "string",
                              "const": "place"
                            },
                            "settlementId": {
                              "type": "string",
                              "pattern": "^stl_[0-9a-z]{8,64}$"
                            }
                          },
                          "required": [
                            "rule",
                            "settlementId"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "role",
                    "form",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "display": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "required": [
              "parts",
              "display"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "personId",
          "birthTick",
          "sex",
          "gender",
          "cultureId",
          "householdId",
          "settlementId",
          "cell",
          "motherId",
          "fatherId",
          "partnerId",
          "maritalStatus",
          "guardian",
          "health",
          "capabilities",
          "name"
