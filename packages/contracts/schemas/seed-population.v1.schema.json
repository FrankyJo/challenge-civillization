{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "worldId": {
      "type": "string",
      "pattern": "^wld_[0-9a-z]{8,64}$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mapHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "params": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "settlementCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "settlementSpacing": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "size",
        "settlementCount",
        "settlementSpacing"
      ],
      "additionalProperties": false
    },
    "regionCultures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^culture\\.[a-z][a-z0-9_]{1,31}$"
      }
    },
    "settlements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "settlementId": {
            "type": "string",
            "pattern": "^stl_[0-9a-z]{8,64}$"
          },
          "cell": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "regionId": {
            "type": "string",
            "pattern": "^rgn_[0-9a-z]{8,64}$"
          },
          "cultureId": {
            "type": "string",
            "pattern": "^culture\\.[a-z][a-z0-9_]{1,31}$"
          },
          "name": {
            "type": "object",
            "properties": {
              "parts": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "given",
                        "patronymic",
                        "matronymic",
                        "clan",
                        "place"
                      ]
                    },
                    "form": {
                      "type": "string",
                      "pattern": "^[a-z]{2,32}$"
                    },
                    "provenance": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "dataset": {
                              "type": "string",
                              "pattern": "^names\\.[a-z][a-z0-9_]{1,31}$"
                            },
                            "version": {
                              "type": "string",
                              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                            },
                            "entryId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40
                            },
                            "fallbackLevel": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4
                            }
                          },
                          "required": [
                            "dataset",
                            "version",
                            "entryId",
                            "fallbackLevel"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "rule": {
                              "type": "string",
                              "enum": [
                                "patronymic",
                                "matronymic",
                                "clan"
                              ]
                            },
                            "from": {
                              "type": "string",
                              "enum": [
                                "father",
                                "mother"
                              ]
                            },
                            "personId": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^per_[0-9a-z]{8,64}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "base": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "dataset": {
                                      "type": "string",
                                      "pattern": "^names\\.[a-z][a-z0-9_]{1,31}$"
                                    },
                                    "version": {
                                      "type": "string",
                                      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                                    },
                                    "entryId": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 40
                                    },
                                    "fallbackLevel": {
