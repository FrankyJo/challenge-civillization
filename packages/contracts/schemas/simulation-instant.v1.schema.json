{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "dayOfYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    }
  },
  "required": [
    "tick",
    "year",
    "dayOfYear"
  ],
  "additionalProperties": false,
  "title": "simulation-instant v1",
  "description": "Integer tick plus derived CE year and day of year."
}
