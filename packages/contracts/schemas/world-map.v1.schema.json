      "type": "object",
      "properties": {
        "terrain": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "deep_ocean",
              "shelf_sea",
              "lake",
              "plains",
              "hills",
              "mountains",
              "high_mountains"
            ]
          }
        },
        "biome": {
          "type": "array",
