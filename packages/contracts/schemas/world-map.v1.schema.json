      "type": "object",
      "properties": {
        "elevationM": {
          "type": "string",
          "const": "metre above sea level (lake cells: water surface)"
        },
        "terrain": {
          "type": "string",
          "const": "index into legend.terrain"
        },
        "biome": {
          "type": "string",
          "const": "index into legend.biome"
        },
        "climateClass": {
          "type": "string",
