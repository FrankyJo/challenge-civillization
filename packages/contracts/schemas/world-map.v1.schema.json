        },
        "temperatureDeciC": {
          "type": "string",
          "const": "0.1 °C, annual mean"
        },
        "precipitationMm": {
          "type": "string",
          "const": "millimetre per year"
        },
        "flags": {
          "type": "string",
          "const": "bitmask (CELL_FLAGS)"
        },
        "landmass": {
          "type": "string",
          "const": "index into landmasses, -1 for water"
        },
        "region": {
          "type": "string",
          "const": "index into regions, -1 for water"
        },
        "waterBody": {
          "type": "string",
          "const": "index into waterBodies, -1 for land"
        },
        "flowTo": {
          "type": "string",
          "const": "cell index of the downstream receiver, -1 for ocean"
        },
        "dischargeM3PerYear": {
          "type": "string",
          "const": "cubic metre per year flowing out of the cell"
        },
        "landAreaHa": {
          "type": "string",
          "const": "hectare"
        },
        "forestHa": {
          "type": "string",
          "const": "hectare"
        },
        "grasslandHa": {
          "type": "string",
          "const": "hectare"
        },
        "wetlandHa": {
          "type": "string",
          "const": "hectare"
        },
        "barrenHa": {
          "type": "string",
          "const": "hectare"
        },
        "arablePotentialHa": {
          "type": "string",
          "const": "hectare cultivable if cleared/drained"
        },
        "timberStockM3": {
          "type": "string",
          "const": "cubic metre standing wood"
        },
        "runoffM3PerYear": {
          "type": "string",
          "const": "cubic metre per year generated in the cell"
        },
        "fishKgPerYear": {
          "type": "string",
          "const": "kilogram per year sustainable catch"
        },
        "floodPpm": {
          "type": "string",
          "const": "parts per million: annual probability of a damaging flood"
        },
        "droughtPpm": {
          "type": "string",
          "const": "parts per million: annual probability of a severe drought"
        },
        "seismicPpm": {
          "type": "string",
          "const": "parts per million: annual probability of a damaging earthquake"
        },
        "wildfirePpm": {
          "type": "string",
          "const": "parts per million: annual probability of a damaging wildfire"
        }
