            "type": "string",
            "enum": [
              "ocean",
              "lake",
              "glacier",
              "alpine_tundra",
              "boreal_forest",
              "temperate_forest",
              "mediterranean_woodland",
              "temperate_grassland",
              "semi_desert",
              "desert",
              "wetland"
            ]
          }
        },
        "climateClass": {
          "type": "array",
