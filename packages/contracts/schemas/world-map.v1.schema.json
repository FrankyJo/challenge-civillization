      "additionalProperties": false
    },
    "mapVersion": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grid": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "const": "hex-pointy-odd-r"
        },
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1024
        },
        "cellSpacingM": {
          "type": "integer",
          "minimum": 500,
          "maximum": 50000
        },
        "rowSpacingM": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "cellAreaM2": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
