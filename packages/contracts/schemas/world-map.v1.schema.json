            "type": "string",
            "enum": [
              "marine",
              "polar_ice",
              "alpine",
              "arid",
              "semi_arid",
              "mediterranean",
              "humid_temperate",
              "cool_temperate"
            ]
          }
        },
        "climateBand": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tropical",
              "subtropical",
              "temperate",
              "subpolar",
              "polar"
            ]
          }
        },
        "mineral": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "copper_ore",
              "tin_ore",
              "iron_ore",
              "precious_metal_ore",
              "salt",
              "building_stone",
              "clay"
            ]
          }
        }
      },
      "required": [
        "terrain",
        "biome",
        "climateClass",
        "climateBand",
        "mineral"
      ],
      "additionalProperties": false
