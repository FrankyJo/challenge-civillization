{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[0-9a-z]{8,64}$"
        },
        "type": {
          "type": "string",
          "const": "world.pause"
        },
        "typeVersion": {
          "type": "number",
          "const": 1
        },
        "worldId": {
          "type": "string",
          "pattern": "^wld_[0-9a-z]{8,64}$"
        },
        "instant": {
          "type": "object",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "year": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "dayOfYear": {
              "type": "integer",
              "minimum": 1,
              "maximum": 366
            }
          },
          "required": [
            "tick",
            "year",
            "dayOfYear"
          ],
          "additionalProperties": false
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "actor": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "system"
                },
                "component": {
                  "type": "string",
                  "enum": [
                    "scheduler",
                    "simulation",
                    "worker"
                  ]
                }
              },
              "required": [
                "kind",
                "component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "operator"
                },
                "operatorId": {
                  "type": "string",
                  "pattern": "^opr_[0-9a-z]{8,64}$"
                }
              },
              "required": [
                "kind",
                "operatorId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        },
        "expectedVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "causationId": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^cmd_[0-9a-z]{8,64}$"
                },
                {
                  "type": "string",
                  "pattern": "^evt_[0-9a-z]{8,64}$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "versions": {
          "type": "object",
          "properties": {
            "engineVersion": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "contentVersion": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "configVersion": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "engineVersion",
            "contentVersion",
            "configVersion"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                {
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}]|[\\n\\t])*$"
                }
              ]
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "commandId",
        "type",
        "typeVersion",
        "worldId",
        "instant",
        "issuedAt",
        "actor",
        "idempotencyKey",
        "expectedVersion",
        "causationId",
        "correlationId",
        "versions",
        "payload"
      ],
      "additionalProperties": false
    },
