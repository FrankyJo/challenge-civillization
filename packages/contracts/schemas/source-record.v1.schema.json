{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src_[0-9a-z]{8,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "authors": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bibliographic"
            },
            "citation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "kind",
            "citation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "primary",
        "scholarly",
        "institutional",
        "reference",
        "other"
      ]
    },
    "publishedOn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accessedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "claimSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "archivedChecksum": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "failed"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sourceId",
    "title",
    "authors",
    "locator",
    "sourceType",
    "publishedOn",
    "accessedAt",
    "claimSummary",
    "license",
    "archivedChecksum",
    "verification"
  ],
  "additionalProperties": false,
  "title": "source-record v1",
  "description": "Cited source with locator, licence, checksum and verification status."
}
