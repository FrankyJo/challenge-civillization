{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "pattern": "^rvw_[0-9a-z]{8,64}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^prp_[0-9a-z]{8,64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "string",
      "enum": [
        "draft",
        "schema_validated",
        "evidence_reviewed",
        "domain_reviewed",
        "simulated",
        "approved",
        "promoted"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "draft",
        "schema_validated",
        "evidence_reviewed",
        "domain_reviewed",
        "simulated",
        "approved",
        "promoted"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "advance",
        "reject"
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "operatorId": {
          "type": "string",
          "pattern": "^opr_[0-9a-z]{8,64}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "editor",
            "operator",
            "administrator"
          ]
        }
      },
      "required": [
        "operatorId",
        "role"
      ],
      "additionalProperties": false
    },
    "findings": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "reviewId",
    "proposalId",
    "revision",
    "from",
    "to",
    "decision",
    "reviewer",
    "findings",
    "decidedAt"
  ],
  "additionalProperties": false,
  "title": "proposal-review v1",
  "description": "One stage decision on a proposal with reviewer identity and findings."
}
