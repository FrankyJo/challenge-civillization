{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "service": {
      "type": "string",
      "enum": [
        "api",
        "simulation",
        "worker"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "down"
      ]
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "service",
    "version",
    "status",
    "checks"
  ],
  "additionalProperties": false,
  "title": "health-report v1",
  "description": "Liveness/readiness report served by every Node process."
}
