{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "worldId": {
      "type": "string",
      "pattern": "^wld_[0-9a-z]{8,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "seed": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2}){8,32}$"
    },
    "startYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "endYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "versions": {
      "type": "object",
      "properties": {
        "engineVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configVersion": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "engineVersion",
        "contentVersion",
        "configVersion"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "createdBy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            },
            "component": {
              "type": "string",
              "enum": [
                "scheduler",
                "simulation",
                "worker"
              ]
            }
          },
          "required": [
            "kind",
            "component"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operator"
            },
            "operatorId": {
              "type": "string",
              "pattern": "^opr_[0-9a-z]{8,64}$"
            }
          },
          "required": [
            "kind",
            "operatorId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "worldId",
    "name",
    "seed",
    "startYear",
    "endYear",
    "versions",
    "createdAt",
    "createdBy"
  ],
  "additionalProperties": false,
  "title": "world-record v1",
  "description": "Immutable world identity: seed, CE calendar span, launch versions, audit fields."
}
