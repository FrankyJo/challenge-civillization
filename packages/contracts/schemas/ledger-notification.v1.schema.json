{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "worldId": {
      "type": "string",
      "pattern": "^wld_[0-9a-z]{8,64}$"
    },
    "fromPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "worldId",
    "fromPosition",
    "toPosition"
  ],
  "additionalProperties": false,
  "title": "ledger-notification v1",
  "description": "Outbox/queue notice that a world's ledger grew; consumers read facts from the ledger, not the notice."
}
