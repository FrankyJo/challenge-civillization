{
  "name": "@civ/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned Zod schemas and boundary parsers shared by all processes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "schemas:write": "pnpm run build && node scripts/write-schema-docs.mjs",
    "fixtures:freeze": "node scripts/freeze-fixtures.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
